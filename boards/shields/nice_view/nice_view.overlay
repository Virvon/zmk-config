/ {
    chosen {
        zmk,display = &nice_view;
    };
};

&spi0 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    sck-pin = <5>;
    mosi-pin = <3>;
    
    cs-gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
    
    nice_view: ls0xx@0 {
        compatible = "sharp,ls0xx";
        label = "DISPLAY";
        spi-max-frequency = <2000000>;
        reg = <0>;
        width = <160>;
        height = <68>;
        disp-en-gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
    };
};