#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// Layer Definitions

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&mt {
    tapping-term-ms = <201>;
    flavor = "tap-preferred";
};

&sk {
    release-after-ms = <2000>;
    quick-release;
};

// Helper for defining combos

#define COMBO(NAME, TIMEOUT, BINDINGS, KEYPOS, LAYERS) \
combo_##NAME { \
    timeout-ms = <TIMEOUT>; \
    bindings = <BINDINGS>; \
    key-positions = <KEYPOS>; \
    layers = <LAYERS>; \
};

/ {
    combos {
        compatible = "zmk,combos";

        COMBO(escape, 50, &kp ESC, 0 1, 0)

        left_parenthesis {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <6 7>;
        };

        right_parenthesis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <7 8>;
        };

        test {
            bindings = <&kp LBKT>;
            key-positions = <16 17>;
            layers = <0>;
        };
    };

    behaviors {
        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_L";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <250>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_R";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <250>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        mo_to: mo_to {
            compatible = "zmk,behavior-hold-tap";
            label = "MO_TO";
            bindings = <&mo>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <LWR RSE>;
            then-layer = <ADJ>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            // .----------------------------------------------------------.       .-----------------------------------------------------------.
            // |   TAB    |    Q    |    W   |   E    |    R    |    T    |       |   Y   |    U    |    I    |    O    |     P    |   BSPC   |
            // |----------+---------+--------+--------+---------+---------|       |-------+---------+---------+---------+----------+----------|
            // |   GESC   |    A    |    S   |   D    |    F    |    G    |       |   H   |    J    |    K    |    L    |     ;    |     '    |
            // |----------+---------+--------+--------+---------+---------|       |-------+---------+---------+---------+----------+----------|
            // |   SHFT   |    Z    |    X   |   C    |    V    |    B    |       |   N   |    M    |    ,    |    .    |     /    |    DEL   |
            // '-----------------------------+--------+---------+---------+       |-------+---------+---------+-------------------------------'
            //                               |  GUI   |  LSFT   |   ENT   |       |  SPC  |  RSHFT  |   GUI   |
            //                               '--------+---------+---------'       '-------+---------+---------'

            bindings = <
&none  &kp Q  &kp W  &kp F          &kp P           &kp B        &kp J       &kp L              &kp U      &kp Y    &kp SEMI  &none
&none  &kp A  &kp R  &kp S          &kp T           &kp G        &kp M       &kp N              &kp R      &kp I    &kp O     &none
&none  &kp Z  &kp X  &kp C          &kp D           &kp V        &kp K       &kp H              &kp COMMA  &kp DOT  &kp FSLH  &none
                     &kp BACKSPACE  &kp LEFT_SHIFT  &kp SPACE    &mo_to 1 2  &kp RIGHT_CONTROL  &kp ENTER
            >;
        };

        LOWER {
            // .----------------------------------------------------------.       .---------------------------------------------------------------.
            // |          |   1   |    2   |   3    |     4    |     5    |       |    6   |     7   |     8   |    9    |     0    |             |
            // |----------+-------+--------+--------+----------+----------|       |--------+---------+---------+---------+----------+-------------|
            // |          |   🔇  |   🔈   |   🔊   |    ⏩    |     ▶    |       |    ⬆   |    ⬇    |    ⬅    |    ⮕   |          |             |
            // |----------+-------+--------+--------+----------+----------|       |--------+---------+---------+---------+----------+-------------|
            // |          |  UNDO |  CUT   |  COPY  |  PASTE   |   PGDN   |       |  CAPS  |   INS   |         |         |          |             |
            // '---------------------------+--------+----------+----------+       |--------+---------+---------+----------------------------------'
            //                             |        |          |          |       |        |         |         |
            //                             '--------+----------+----------'       '--------+---------+---------'

            bindings = <
&trans  &kp N1      &kp N2        &kp N3        &kp N4       &kp N5        &kp N6    &kp N7      &kp N8  &kp N9     &kp N0  &trans
&trans  &kp K_MUTE  &kp K_VOL_DN  &kp K_VOL_UP  &kp K_NEXT   &kp C_PLAY    &kp LEFT  &kp DOWN    &kp UP  &kp RIGHT  &trans  &trans
&trans  &kp K_UNDO  &kp K_CUT     &kp K_COPY    &kp K_PASTE  &kp PG_DN     &kp CAPS  &kp INSERT  &trans  &trans     &trans  &trans
                                  &trans        &trans       &trans        &trans    &trans      &trans
            >;
        };

        RAISE {
            // .----------------------------------------------------------.       .-----------------------------------------------------------.
            // |   ESC    |    !    |    @   |   #    |    $    |    %    |       |   ^   |    &    |    *    |    (    |     )    |          |
            // |----------+---------+--------+--------+---------+---------|       |-------+---------+---------+---------+----------+----------|
            // |          |    _    |    +   |   =    |    |    |    -    |       |  HOME |   PGDN  |   PGUP  |   END   |   PSCRN  |    `     |
            // |----------+---------+--------+--------+---------+---------|       |-------+---------+---------+---------+----------+----------|
            // |          |    \    |    <   |   {    |    (    |    [    |       |   ]   |    )    |    }    |    >    |     /    |          |
            // '-----------------------------+--------+---------+---------+       |-------+---------+---------+-------------------------------'
            //                               |        |         |         |       |       |         |         |
            //                               '--------+---------+---------'       '-------+---------+---------'

            bindings = <
&kp ESC  &kp EXCL   &kp AT    &kp HASH   &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR   &trans
&trans   &kp UNDER  &kp PLUS  &kp EQUAL  &kp PIPE  &kp MINUS    &kp HOME   &kp PG_DN  &kp PG_UP  &kp END   &kp PSCRN  &kp GRAVE
&trans   &kp BSLH   &kp LT    &kp LBRC   &kp LPAR  &kp LBKT     &kp RBKT   &kp RPAR   &kp RBRC   &kp GT    &kp FSLH   &trans
                              &trans     &trans    &trans       &to 0      &trans     &trans
            >;
        };

        ADJUST {
            // .---------------------------------------------------------.       .--------------------------------------------------------------.
            // |          |   F1   |   F2   |   F3   |   F4    |   F5    |       |   F6   |   F7   |   F8    |   F9    |   F10    |             |
            // |----------+--------+--------+--------+---------+---------|       |--------+--------+---------+---------+----------+-------------|
            // |  BTCLR   |  BT1   |  BT2   |  BT3   |  BT4    |  BT5    |       |        |        |         |   F11   |   F12    |  BT Toggle  |
            // |----------+--------+--------+--------+---------+---------|       |--------+--------+---------+---------+----------+-------------|
            // |          |        |        |        |         |         |       |        |        |         |         |          |             |
            // '----------------------------+--------+---------+---------+       |--------+--------+---------+----------------------------------'
            //                              |        |         |         |       |        |        |         |
            //                              '--------+---------+---------'       '--------+--------+---------'

            bindings = <
&sys_reset  &kp F1        &kp F2        &kp F3        &kp F4        &kp F5          &kp F6  &kp F7  &kp F8  &kp F9   &kp F10  &sys_reset
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans  &kp F11  &kp F12  &trans
&trans      &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans   &trans   &trans
                                        &trans        &trans        &trans          &trans  &trans  &trans
            >;
        };
    };
};
