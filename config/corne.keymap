#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// Layer Definitions

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&mt {
    tapping-term-ms = <201>;
    flavor = "tap-preferred";
};

&sk {
    release-after-ms = <2000>;
    quick-release;
};

// Helper for defining combos

#define COMBO(NAME, TIMEOUT, BINDINGS, KEYPOS, LAYERS) \
combo_##NAME { \
    timeout-ms = <TIMEOUT>; \
    bindings = <BINDINGS>; \
    key-positions = <KEYPOS>; \
    layers = <LAYERS>; \
};

/ {
    combos {
        compatible = "zmk,combos";

        COMBO(escape, 50, &kp ESC, 0 1, 0)

        left_parenthesis {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <6 7>;
            layers = <0>;
        };

        right_parenthesis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <7 8>;
            layers = <0>;
        };

        left_bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <18 19>;
            layers = <0>;
        };

        right_bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <19 20>;
            layers = <0>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <30 31>;
            layers = <0>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <31 32>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <16 17>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <28 29>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <4 5>;
        };
    };

    behaviors {
        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_L";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <250>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_R";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <250>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        mo_to: mo_to {
            compatible = "zmk,behavior-hold-tap";
            label = "MO_TO";
            bindings = <&mo>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
        };

        td_n: td_n {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_N";
            #binding-cells = <0>;
            bindings = <&kp N>, <&kp SEMICOLON>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <LWR RSE>;
            then-layer = <ADJ>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            // .----------------------------------------------------------.       .-----------------------------------------------------------.
            // |   TAB    |    Q    |    W   |   E    |    R    |    T    |       |   Y   |    U    |    I    |    O    |     P    |   BSPC   |
            // |----------+---------+--------+--------+---------+---------|       |-------+---------+---------+---------+----------+----------|
            // |   GESC   |    A    |    S   |   D    |    F    |    G    |       |   H   |    J    |    K    |    L    |     ;    |     '    |
            // |----------+---------+--------+--------+---------+---------|       |-------+---------+---------+---------+----------+----------|
            // |   SHFT   |    Z    |    X   |   C    |    V    |    B    |       |   N   |    M    |    ,    |    .    |     /    |    DEL   |
            // '-----------------------------+--------+---------+---------+       |-------+---------+---------+-------------------------------'
            //                               |  GUI   |  LSFT   |   ENT   |       |  SPC  |  RSHFT  |   GUI   |
            //                               '--------+---------+---------'       '-------+---------+---------'

            bindings = <
&kp Q           &kp W           &kp F          &kp P           &kp B        &kp J  &kp L              &kp U      &kp Y    &kp SEMI
&kp A           &kp R           &kp S          &kp T           &kp G        &kp M  &td_n              &kp R      &kp I    &kp O
&mt LEFT_WIN Z  &mt LEFT_ALT X  &kp C          &kp D           &kp V        &kp K  &kp H              &kp COMMA  &kp DOT  &kp FSLH
                                       &kp BACKSPACE  &kp LEFT_SHIFT  &kp SPACE    &mo 1  &kp RIGHT_CONTROL  &kp ENTER
            >;
        };

        LOWER {
            // .----------------------------------------------------------.       .---------------------------------------------------------------.
            // |          |   1   |    2   |   3    |     4    |     5    |       |    6   |     7   |     8   |    9    |     0    |             |
            // |----------+-------+--------+--------+----------+----------|       |--------+---------+---------+---------+----------+-------------|
            // |          |   🔇  |   🔈   |   🔊   |    ⏩    |     ▶    |       |    ⬆   |    ⬇    |    ⬅    |    ⮕   |          |             |
            // |----------+-------+--------+--------+----------+----------|       |--------+---------+---------+---------+----------+-------------|
            // |          |  UNDO |  CUT   |  COPY  |  PASTE   |   PGDN   |       |  CAPS  |   INS   |         |         |          |             |
            // '---------------------------+--------+----------+----------+       |--------+---------+---------+----------------------------------'
            //                             |        |          |          |       |        |         |         |
            //                             '--------+----------+----------'       '--------+---------+---------'

            bindings = <
&kp N1  &kp N2          &kp N3          &kp N4           &kp N5    &kp N6                   &kp N7           &kp N8             &kp N9      &kp N0
&none   &none           &kp UP_ARROW    &none            &none     &mt K_MUTE C_PLAY_PAUSE  &kp K_VOLUME_UP  &kp K_VOLUME_DOWN  &kp K_NEXT  &kp K_PREV
&none   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none     &none                    &none            &none              &none       &none
                               &trans          &trans           &trans    &trans                   &trans           &trans
            >;
        };

        RAISE {
            // .----------------------------------------------------------.       .-----------------------------------------------------------.
            // |   ESC    |    !    |    @   |   #    |    $    |    %    |       |   ^   |    &    |    *    |    (    |     )    |          |
            // |----------+---------+--------+--------+---------+---------|       |-------+---------+---------+---------+----------+----------|
            // |          |    _    |    +   |   =    |    |    |    -    |       |  HOME |   PGDN  |   PGUP  |   END   |   PSCRN  |    `     |
            // |----------+---------+--------+--------+---------+---------|       |-------+---------+---------+---------+----------+----------|
            // |          |    \    |    <   |   {    |    (    |    [    |       |   ]   |    )    |    }    |    >    |     /    |          |
            // '-----------------------------+--------+---------+---------+       |-------+---------+---------+-------------------------------'
            //                               |        |         |         |       |       |         |         |
            //                               '--------+---------+---------'       '-------+---------+---------'

            bindings = <
&kp EXCL   &kp AT    &kp HASH   &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR
&kp UNDER  &kp PLUS  &kp EQUAL  &kp PIPE  &kp MINUS    &kp HOME   &kp PG_DN  &kp PG_UP  &kp END   &kp PSCRN
&kp BSLH   &kp LT    &kp LBRC   &kp LPAR  &kp LBKT     &kp RBKT   &kp RPAR   &kp RBRC   &kp GT    &kp FSLH
                              &trans     &trans    &trans       &to 0      &trans     &trans
            >;
        };

        ADJUST {
            // .---------------------------------------------------------.       .--------------------------------------------------------------.
            // |          |   F1   |   F2   |   F3   |   F4    |   F5    |       |   F6   |   F7   |   F8    |   F9    |   F10    |             |
            // |----------+--------+--------+--------+---------+---------|       |--------+--------+---------+---------+----------+-------------|
            // |  BTCLR   |  BT1   |  BT2   |  BT3   |  BT4    |  BT5    |       |        |        |         |   F11   |   F12    |  BT Toggle  |
            // |----------+--------+--------+--------+---------+---------|       |--------+--------+---------+---------+----------+-------------|
            // |          |        |        |        |         |         |       |        |        |         |         |          |             |
            // '----------------------------+--------+---------+---------+       |--------+--------+---------+----------------------------------'
            //                              |        |         |         |       |        |        |         |
            //                              '--------+---------+---------'       '--------+--------+---------'

            bindings = <
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5          &kp F6  &kp F7  &kp F8  &kp F9   &kp F10
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans  &kp F11  &kp F12
&trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans   &trans
                                        &trans        &trans        &trans          &trans  &trans  &trans
            >;
        };
    };
};
